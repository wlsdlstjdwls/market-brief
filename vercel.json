{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/dispatch?s=am",
      "schedule": "10,20,30,40,50 23 * * 0-4"
    },
    {
      "path": "/api/cron/dispatch?s=am&n=2",
      "schedule": "0 0 * * 1-5"
    },
    {
      "path": "/api/cron/dispatch?s=pm",
      "schedule": "40,50 7 * * 1-5"
    },
    {
      "path": "/api/cron/dispatch?s=pm&n=2",
      "schedule": "0,10,20,30,40 8 * * 1-5"
    },
    {
      "path": "/api/cron/dispatch?s=pm&n=3",
      "schedule": "40 9 * * 1-5"
    }
  ]
}
